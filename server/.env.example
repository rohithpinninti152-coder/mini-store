# Postgres connection (matches docker-compose.yml for local dev)
DATABASE_URL=postgres://store:store@localhost:5432/store

# Port the API listens on
PORT=4000

# Simple password for the seller admin pages (sent as the x-admin-token header)
ADMIN_TOKEN=change-me

# Optional: enables the "Write with AI" product description button
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
